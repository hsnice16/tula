node_modules/
dist/
*.log

# Belt and braces: credentials live in ~/.config/tula, never the repo.
# This catches a stray copy before it reaches a commit.
*.key
credentials.json
.env
.env.*

# The site is a separate package: its dependencies never enter the binary.
site/node_modules
site/.next
site/out
site/next-env.d.ts
site/tsconfig.tsbuildinfo

# Copied from the repository root at site build time.
site/public/install.sh

# Agent tooling writes machine-local settings here, and the skill beside them is
# tracked — so the directory is half-tracked and `git add -A` would take this.
.claude/settings.local.json

# macOS writes one into any directory the Finder opens.
.DS_Store

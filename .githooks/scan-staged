#!/usr/bin/env bash
# Refuses a commit whose staged content looks like a credential.
#
# This repository is public and the binary reads exchange keys, so the cheapest
# moment to catch a pasted secret is before it exists in history — once pushed,
# rotating the key is the only real remedy. Scans the staged *content*, not the
# working tree: `git add -p` can stage a hunk the file no longer shows.
#
#   bash .githooks/scan-staged
set -uo pipefail

ROOT=$(git rev-parse --show-toplevel)
ALLOW="$ROOT/.githooks/allowed-secrets"

# Collected in a file, not a variable: the scans run inside pipelines, and a
# pipeline's last stage is a subshell whose variables do not survive it.
FINDINGS=$(mktemp)
trap 'rm -f "$FINDINGS"' EXIT

allowed() {
  [ -f "$ALLOW" ] || return 1
  # Comments and blank lines are not patterns; anything else is matched literally.
  grep -v '^[[:space:]]*#' "$ALLOW" | grep -v '^[[:space:]]*$' |
    grep -qFx -- "$1" 2>/dev/null
}

# Key material and provider-issued tokens. Deliberately narrow: a pattern that
# fires on ordinary code teaches people to pass --no-verify, which is worse than
# no hook at all.
SECRETS='sk-ant-[A-Za-z0-9_-]{20,}
sk_live_[A-Za-z0-9]{16,}
rk_live_[A-Za-z0-9]{16,}
AKIA[0-9A-Z]{16}
gh[pousr]_[A-Za-z0-9]{30,}
github_pat_[A-Za-z0-9_]{30,}
xox[baprs]-[A-Za-z0-9-]{20,}
AIza[0-9A-Za-z_-]{30,}
-----BEGIN [A-Z ]*PRIVATE KEY-----'

# NUL-delimited, and read rather than word-split. `for path in $(…)` split on
# whitespace, so a staged `my key.env` became two paths that do not exist, each
# producing an empty diff — never scanned, and silently: a scanner with a blind
# spot you choose by naming the file.
while IFS= read -r -d '' path; do
  # No extension skip. git already reports a real binary as "Binary files …
  # differ" and produces no added lines, so the scan costs nothing there — while
  # skipping by name let a credential through in a text file called `logo.png`.

  # A lockfile is wall-to-wall integrity hashes, so the general patterns below
  # would fire on every line of it. The one credential that can land in one is
  # a registry auth line, and that is worth looking for on its own.
  case "$path" in
    *.lock | *lock.json)
      git diff --cached --no-color -U0 -- "$path" | sed -n 's/^+//p' |
        grep -oiE '(_auth(Token)?|_password)[[:space:]]*=?[[:space:]]*[^[:space:]]+' |
        sort -u |
        while IFS= read -r hit; do
          [ -n "$hit" ] || continue
          printf '%s\n' "$path|${hit:0:28}…  (a registry credential in a lockfile)"
        done >>"$FINDINGS"
      continue
      ;;
  esac
  git diff --cached --no-color -U0 -- "$path" >/dev/null 2>&1 || continue

  added=$(git diff --cached --no-color -U0 -- "$path" | sed -n 's/^+//p')
  [ -n "$added" ] || continue

  while IFS= read -r pattern; do
    [ -n "$pattern" ] || continue
    # `--` because a PEM header begins with dashes, which grep would otherwise
    # read as options and then match nothing at all; and read -r rather than
    # word-splitting, because that same header contains spaces.
    printf '%s\n' "$added" | grep -oE -- "$pattern" 2>/dev/null | sort -u |
      while IFS= read -r hit; do
        [ -n "$hit" ] || continue
        allowed "$hit" && continue
        printf '%s\n' "$path|${hit:0:28}…"
      done
  done <<EOF >>"$FINDINGS"
$SECRETS
EOF

  # An address is not secret, but a real one in this repository is somebody's
  # holdings — CONTRIBUTING forbids it "including test fixtures and pasted
  # output". Public contracts tula reads from are listed in the allowlist.
  #
  # A 64-hex run is excluded first and reported below instead. A private key
  # opens with 40 hex characters like everything else, and the address wording
  # sent whoever pasted one to the allowlist — advice that commits a live key.
  printf '%s\n' "$added" | grep -oiE '0x[a-f0-9]{40,}' | sort -u |
    while IFS= read -r hit; do
      [ -n "$hit" ] || continue
      [ ${#hit} -eq 42 ] || continue
      allowed "$hit" && continue
      allowed "$(printf '%s' "$hit" | tr 'A-Z' 'a-z')" && continue
      printf '%s\n' "$path|$hit  (an address — allowlist it if this is a public contract)"
    done >>"$FINDINGS"

  # 64 hex characters, with or without the prefix, is the shape of an EVM
  # private key. A long zero run is not: that is ABI padding around an address
  # or a number, which is most of what encoded calldata looks like, and the
  # scanner has to stay quiet about the encoder's own tests to be worth having.
  printf '%s\n' "$added" | grep -oiE '(0x)?[a-f0-9]{64}' |
    grep -viE '0{12}' | sort -u |
    while IFS= read -r hit; do
      [ -n "$hit" ] || continue
      allowed "$hit" && continue
      allowed "$(printf '%s' "$hit" | tr 'A-Z' 'a-z')" && continue
      printf '%s\n' "$path|${hit:0:14}…  (64 hex — a private key has this shape)"
    done >>"$FINDINGS"

  # The venue credentials this tool exists to hold — Kraken's 88-character
  # base64 secret, Binance's 64-character key — carry no vendor prefix, so the
  # list above cannot see them. Matching the *assignment* rather than the value
  # keeps that from firing on every hash and base64 blob in the tree.
  # The value may be quoted or bare: `KRAKEN_API_SECRET=<value>` in a .env or a
  # pasted shell line is the commonest shape a leaked credential actually has,
  # and requiring quotes missed all of them.
  printf '%s\n' "$added" |
    grep -oiE "(secret|passphrase|password|api[_-]?key|private[_-]?key|auth[_-]?token|access[_-]?token)[\"']?[[:space:]]*[:=][[:space:]]*[\"']?[A-Za-z0-9+/=_-]{20,}" |
    sort -u |
    while IFS= read -r hit; do
      [ -n "$hit" ] || continue
      allowed "$hit" && continue
      printf '%s\n' "$path|${hit:0:28}…  (a secret-shaped value assigned to a secret-shaped name)"
    done >>"$FINDINGS"

  # Twelve or more lowercase words inside one quoted string. Prose is not
  # quoted, so this shape is a seed phrase and essentially nothing else — the
  # one credential tula promises never even to ask for.
  printf '%s\n' "$added" |
    grep -oE "[\"']([a-z]{3,8} ){11,23}[a-z]{3,8}[\"']" | sort -u |
    while IFS= read -r hit; do
      [ -n "$hit" ] || continue
      printf '%s\n' "$path|${hit:0:24}…  (12+ words in one string — a seed phrase has this shape)"
    done >>"$FINDINGS"
done < <(git diff --cached --name-only -z --diff-filter=ACM)

[ -s "$FINDINGS" ] || exit 0

printf '\n✗ commit blocked: staged content looks like a credential\n\n' >&2
sort -u "$FINDINGS" | while IFS='|' read -r where what; do
  printf '  %s\n    %s\n' "$where" "$what" >&2
done
cat >&2 <<'EOF'

  Nothing was committed. Remove it, or — if this is a published vendor test
  vector or a public contract address — add it to .githooks/allowed-secrets.
EOF
exit 1
